# source this before ./ralph.sh (macOS)
export JAVA_HOME="$(/usr/libexec/java_home -v 17 2>/dev/null)"
if [ -z "${ANDROID_HOME:-}" ]; then
  for d in "$HOME/Library/Android/sdk" "/opt/homebrew/share/android-commandlinetools"; do
    [ -d "$d" ] && export ANDROID_HOME="$d" && break
  done
fi
export PATH="$ANDROID_HOME/platform-tools:$PATH"
corepack enable >/dev/null 2>&1 || true
echo "JAVA_HOME=$JAVA_HOME"; echo "ANDROID_HOME=$ANDROID_HOME"
command -v adb >/dev/null && adb devices | sed 1d
